# Copy this file to `.env` and edit if you want to enable real data fetchers.

# --- Data mode ---
# false = use synthetic-Delhi data (default, works offline, fast)
# true  = fetch real data from OpenAQ + Open-Meteo (needs internet, slower)
USE_REAL_DATA=false

# --- Optional API keys (only needed if you enable real fetchers) ---
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=

# --- Optional: LLM for freeform citizen advisory ---
# If unset, the app uses deterministic templates (recommended for demo)
GOOGLE_API_KEY=
